# Copy this file to .env for a manual PM2 deployment; do not edit .env.example in place.
# The recommended systemd deployment instead reads /etc/aws-vpn-restart.env.

# Node.js executable used by systemd services. Set this to the exact output of:
# command -v node
# This must be an absolute path; it is especially important if Node was installed with nvm.
NODE_BIN=/usr/bin/node

# HTTP endpoint configuration
# Use a long, unguessable path; it is not shown or linked by the application.
PORT=3000
HOST=0.0.0.0
STOP_PATH=/stop-REPLACE_WITH_A_LONG_RANDOM_VALUE
# Required. Send it as: Authorization: Bearer <value>, or append ?token=<value> to the URL.
RESTART_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Wait for the HTTP 202 response to be delivered before calling AWS StopInstances (1–60 seconds).
STOP_REQUEST_DELAY_SECONDS=3

# SMTP email configuration
# Gmail: smtp.gmail.com / 587 / App Password (not the normal account password)
# SendGrid: smtp.sendgrid.net / 587 / SMTP user "apikey" / API key as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set true for implicit TLS, normally port 465. Port 587 uses STARTTLS when available.
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
NOTIFICATION_EMAIL=recipient@example.com
INSTANCE_NAME=My EC2 instance
