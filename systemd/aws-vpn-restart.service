[Unit]
Description=EC2 self-stop HTTP endpoint
Wants=network-online.target
After=network-online.target
# A broken Node path, configuration, or occupied port must become visible as a
# failed unit rather than continuously respawning npm/Node at boot.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/aws-ec2-renew-ip
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/ubuntu/.nvm/versions/node/v22.23.3/bin
EnvironmentFile=/home/ubuntu/aws-ec2-renew-ip/aws-vpn-restart.env
# Run the configured Node binary directly. Do not invoke npm or PM2 here:
# npm installed through nvm commonly relies on an interactive-shell PATH.
ExecStart=/usr/bin/env ${NODE_BIN} /opt/aws-vpn-restart/server.js
Restart=on-failure
RestartSec=10
User=ubuntu
Group=ubuntu
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
