[Unit]
Description=EC2 self-stop HTTP endpoint
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aws-vpn-restart
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/ubuntu/.nvm/versions/node/v22.23.3/bin
EnvironmentFile=/etc/aws-vpn-restart.env
ExecStart=/usr/bin/env ${NODE_BIN} /opt/aws-vpn-restart/server.js
Restart=always
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
