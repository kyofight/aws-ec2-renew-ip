[Unit]
Description=Email EC2 public IP after every system boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/aws-vpn-restart
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/ubuntu/.nvm/versions/node/v22.23.3/bin
EnvironmentFile=/etc/aws-vpn-restart.env
ExecStart=/opt/aws-vpn-restart/notify-public-ip.sh
Restart=on-failure
RestartSec=30
User=root
Group=root

[Install]
WantedBy=multi-user.target
