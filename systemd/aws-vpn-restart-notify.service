[Unit]
Description=Email EC2 public IP after every system boot
Wants=network-online.target
After=network-online.target aws-vpn-restart.service
# Retry only a bounded number of failed notifier starts in a one-hour window.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/aws-ec2-renew-ip
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/ubuntu/.nvm/versions/node/v22.23.3/bin
EnvironmentFile=/home/ubuntu/aws-ec2-renew-ip/aws-vpn-restart.env
ExecStart=/home/ubuntu/aws-ec2-renew-ip/notify-public-ip.sh
# The script has bounded IMDS retries and the mailer has bounded SMTP timeouts.
TimeoutStartSec=4min
Restart=on-failure
RestartSec=5min
# Notification delivery is non-critical boot work. Deprioritize it so it cannot
# starve SSH, networking, or the HTTP endpoint on a small instance.
Nice=10
CPUQuota=20%
IOSchedulingClass=idle
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
