[Unit]
Description=Email EC2 public IP after every system boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/aws-ec2-renew-ip
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/ubuntu/.nvm/versions/node/v22.23.3/bin
EnvironmentFile=/home/ubuntu/aws-ec2-renew-ip/aws-vpn-restart.env
ExecStart=/home/ubuntu/aws-ec2-renew-ip/notify-public-ip.sh
Restart=on-failure
RestartSec=30
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
